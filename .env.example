# Copy to .env and adjust:   cp .env.example .env
# Relative paths are resolved against the project folder, wherever you start the server from.

# --- Model (must match a name shown by `ollama list`) -----------------------------------------
# Good on a CPU-only laptop. Alternatives: gemma3:1b-it-qat (faster), gemma3:4b, gemma2:9b (needs a GPU)
MODEL_NAME=gemma4:e2b-it-qat
OLLAMA_BASE_URL=http://localhost:11434

# --- Speed knobs (all optional) -----------------------------------------------------------------
# EMOTION_ANALYSIS_ENABLED=false   # skips one extra model call per message
# RAG_TOP_K=2                      # fewer reference passages = shorter prompt = faster first word
# RECENT_TURNS=6                   # how many earlier messages the model sees
# LLM_NUM_CTX=4096

# --- Where your data lives ----------------------------------------------------------------------
# SQLITE_DB_PATH=./memory.db
# QDRANT_STORAGE_PATH=./qdrant_storage
# FASTEMBED_CACHE_PATH=./fastembed_cache

# --- Safety: shown when self-harm language is detected. Replace with real, local resources. ----
# CRISIS_RESOURCES_TEXT="If you're in immediate danger, call <your local emergency number> or <your local crisis line> now."
